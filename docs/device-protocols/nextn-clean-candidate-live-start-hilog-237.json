    "page": "cold-start-live-hilog-diagnostics",
    "orientation": "portrait",
    "resolution": "1320x2120",
    "notes": "Exact-target 237 read-only startup diagnosis. Preserve application data. Schedule one ordinary EntryAbility start after the live system hilog stream is already attached, wait five seconds, then read the surviving process/window/fault directory. Do not install, clear data, clear hilog, uninstall, sign out, navigate in NextN, enter credentials, act on CAPTCHA, submit, mutate account state, or operate another target. KEYCODE_UNKNOWN is deliberately non-actionable and only provides the checked runner measurement boundary while the scheduled launch and live hilog complete."
  },
  "preflight": [
    {
      "name": "wake-authorized-237",
      "hdcArgs": ["shell", "power-shell", "wakeup"]
    },
    {
      "name": "apply-unattended-timeout",
      "hdcArgs": ["shell", "power-shell", "timeout", "-o", "86400000"]
    },
    {
      "name": "cold-stop-nextn-with-data-preserved",
      "hdcArgs": ["shell", "aa", "force-stop", "com.erosteam.nextn"],
      "pauseAfterMs": 300
    },
    {
      "name": "schedule-one-start-after-live-hilog-attaches",
      "hdcArgs": ["shell", "sh", "-c", "nohup sh -c 'sleep 2; aa start -b com.erosteam.nextn -a EntryAbility' >/data/local/tmp/nextn-live-start.log 2>&1 &"]
    }
  ],
  "measurement": {
    "hilog": {
      "hdcArgs": ["shell", "hilog", "-v", "time"],
      "localFile": "hilog.txt"
    },
    "actions": [
      {
        "name": "non-actionable-five-second-observation-boundary",
        "uiInput": ["keyEvent", "KEYCODE_UNKNOWN"],
        "pauseAfterMs": 5000
      }
    ]
  },
  "postflight": [
    {
      "name": "read-scheduled-start-result",
      "hdcArgs": ["shell", "cat", "/data/local/tmp/nextn-live-start.log"]
    },
    {
      "name": "read-nextn-process-after-start",
      "hdcArgs": ["shell", "pidof", "com.erosteam.nextn"]
    },
    {
      "name": "read-window-after-start",
      "hdcArgs": ["shell", "hidumper", "-s", "WindowManagerService", "-a", "-a"]
    },
    {
      "name": "list-faultlogger-directory",
      "hdcArgs": ["shell", "ls", "-lt", "/data/log/faultlog/faultlogger"]
    },
    {
      "name": "verify-awake-and-timeout",
