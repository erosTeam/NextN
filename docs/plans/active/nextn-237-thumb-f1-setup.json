{
  "schemaVersion": 1,
  "name": "nextn-237-thumb-f1-setup",
  "target": "192.168.50.237:12345",
  "authorizedTarget": "192.168.50.237:12345",
  "hdc": "/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc",
  "artifactDir": "/Users/honjow/git/NextN-wt/shared-reader-refactor/.hvigor/outputs/nextn-237-thumb-f1-setup/run",
  "display": {
    "widthPx": 1320,
    "heightPx": 2120
  },
  "context": {
    "project": "NextN",
    "codeIdentity": "NextN F1 bridge (Coordinator.open + startOpening + notifyReady)",
    "page": "Install candidate, cold start direct to gallery 673508 on shared backend, scroll to preview rail and dump layout",
    "deviceAlias": "device237",
    "deviceModel": "VDE-AL00",
    "foldState": "not-applicable",
    "orientation": "portrait",
    "resolution": "1320x2120",
    "notes": "setup for F1 thumbnail entry recording"
  },
  "preflight": [
    {
      "name": "wake",
      "hdcArgs": [
        "shell",
        "power-shell",
        "wakeup"
      ]
    },
    {
      "name": "install-main",
      "hdcArgs": [
        "install",
        "-r",
        "/Users/honjow/git/NextN-wt/shared-reader-refactor/entry/build/default/outputs/default/entry-default-signed.hap"
      ],
      "timeoutSeconds": 300
    },
    {
      "name": "force-stop",
      "hdcArgs": [
        "shell",
        "aa",
        "force-stop",
        "com.erosteam.nextn"
      ]
    },
    {
      "name": "cold-open",
      "hdcArgs": [
        "shell",
        "aa",
        "start",
        "-b",
        "com.erosteam.nextn",
        "-a",
        "EntryAbility",
        "--ps",
        "nextn_reader_backend",
        "shared",
        "--pi",
        "nextn_gallery_id",
        "673508"
      ],
      "timeoutSeconds": 20
    },
    {
      "name": "settle-detail",
      "hdcArgs": [
        "shell",
        "sleep",
        "6"
      ]
    },
    {
      "name": "scroll-to-rail",
      "hdcArgs": [
        "shell",
        "uitest",
        "uiInput",
        "swipe",
        "660",
        "1600",
        "660",
        "400",
        "600"
      ],
      "timeoutSeconds": 10
    },
    {
      "name": "settle-rail",
      "hdcArgs": [
        "shell",
        "sleep",
        "4"
      ]
    },
    {
      "name": "rail-dump",
      "hdcArgs": [
        "shell",
        "uitest",
        "dumpLayout",
        "-p",
        "/data/local/tmp/rail-f1.json",
        "-a"
      ],
      "timeoutSeconds": 20
    },
    {
      "name": "rail-recv",
      "hdcArgs": [
        "file",
        "recv",
        "/data/local/tmp/rail-f1.json",
        "/Users/honjow/git/NextN-wt/shared-reader-refactor/.hvigor/outputs/nextn-237-thumb-f1-setup/run/rail.json"
      ]
    },
    {
      "name": "rail-shot",
      "hdcArgs": [
        "shell",
        "uitest",
        "screenCap",
        "-p",
        "/data/local/tmp/rail-f1.png"
      ]
    },
    {
      "name": "rail-recv-shot",
      "hdcArgs": [
        "file",
        "recv",
        "/data/local/tmp/rail-f1.png",
        "/Users/honjow/git/NextN-wt/shared-reader-refactor/.hvigor/outputs/nextn-237-thumb-f1-setup/run/rail.png"
      ]
    }
  ],
  "measurement": {
    "actions": []
  },
  "postflight": []
}